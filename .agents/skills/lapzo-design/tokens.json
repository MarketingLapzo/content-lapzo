{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_meta": {
    "name": "Lapzo Design Tokens",
    "version": "2.0",
    "source": "colors_and_type.css — brand manual v2.0 (rebranding 2025-2026)",
    "note": "Fuente machine-readable de los tokens. Mantener en sync con colors_and_type.css. Usar para generar código React/Tailwind/JS de producción."
  },

  "color": {
    "violet": {
      "darkest":  "#240C50",
      "dark":     "#5029A3",
      "mid":      "#5B19BE",
      "700":      "#6E1FE2",
      "brand":    "#7D31F6",
      "base":     "#8B55FE",
      "light":    "#A685FF",
      "pastel1":  "#C3B1FF",
      "pastel2":  "#DDD4FF",
      "pastel3":  "#ECE8FF",
      "soft":     "#F5F2FF",
      "mist":     "#DFD9F8",
      "stroke":   "#C5A9FF"
    },
    "teal": {
      "darkest":  "#012D33",
      "dark":     "#0F4C52",
      "mid":      "#0C5C63",
      "700":      "#08757D",
      "base":     "#04949D",
      "light":    "#08BEC4",
      "mint":     "#21DDE0",
      "bright":   "#54F4F2",
      "pastel":   "#92FDF7",
      "soft":     "#C9FEFB",
      "min":      "#EFFEFC"
    },
    "foundation": {
      "bgDark":    "#14142A",
      "bgPage":    "#F8FAFC",
      "bgSoft":    "#F7F7FC",
      "bgCardbox": "#F0EEEE",
      "white":     "#FFFFFF"
    },
    "secondary": {
      "pink":        "#F3538E",
      "pinkMid":     "#F9A6C4",
      "pinkLight":   "#FFD3E3",
      "orange":      "#F9912A",
      "orangeMid":   "#FBBE81",
      "orangeLight": "#FDE0C3",
      "green":       "#01DA8C",
      "greenMid":    "#7BECC3",
      "greenLight":  "#CCFFEC",
      "blue":        "#2F80ED",
      "blueMid":     "#7FB2F0",
      "blueLight":   "#D6E6FB",
      "yellow":      "#F2C94C",
      "yellowMid":   "#F7DEBA",
      "yellowLight": "#FFF3CC"
    },
    "text": {
      "ink":        "#3F3F46",
      "ink2":       "#71717A",
      "ink3":       "#475569",
      "ink4":       "#94A3B8",
      "border":     "#E2E2E8",
      "borderSoft": "#EFF0F6",
      "divider":    "#D9DBE9"
    },
    "semantic": {
      "accent":     "#8B55FE",
      "accentDeep": "#240C50",
      "accentSoft": "#F5F2FF",
      "success":    "#01DA8C",
      "warning":    "#F9912A",
      "danger":     "#F3538E",
      "info":       "#2F80ED"
    }
  },

  "module": {
    "capacitacion": { "abbr": "CyA", "color": "#F9912A", "pastel": "#FDE0C3" },
    "desarrollo":   { "abbr": "DxC", "color": "#5029A3", "pastel": "#DDD4FF" },
    "evaluaciones": { "abbr": "EVA", "color": "#04949D", "pastel": "#CCFFEC" },
    "estrategia":   { "abbr": "S&E", "color": "#F3538E", "pastel": "#FFD3E3" },
    "catalogo":     { "abbr": "CAT", "color": "#2F80ED", "pastel": "#D6E6FB" }
  },

  "chart": {
    "_note": "Paleta categórica para People Analytics. Orden = máxima distinción visual. Para series secuenciales usar sequentialViolet/sequentialTeal. Texto sobre fill: usar el tono *dark del mismo color.",
    "categorical": [
      "#8B55FE",
      "#04949D",
      "#F9912A",
      "#F3538E",
      "#2F80ED",
      "#01DA8C",
      "#F2C94C",
      "#5029A3"
    ],
    "categoricalSoft": [
      "#C3B1FF",
      "#92FDF7",
      "#FDE0C3",
      "#FFD3E3",
      "#D6E6FB",
      "#CCFFEC",
      "#FFF3CC",
      "#DDD4FF"
    ],
    "sequentialViolet": ["#ECE8FF", "#DDD4FF", "#C3B1FF", "#A685FF", "#8B55FE", "#7D31F6", "#5029A3", "#240C50"],
    "sequentialTeal":   ["#EFFEFC", "#C9FEFB", "#92FDF7", "#54F4F2", "#21DDE0", "#04949D", "#0C5C63", "#012D33"],
    "diverging":  ["#F3538E", "#F9A6C4", "#EFF0F6", "#C3B1FF", "#8B55FE"],
    "positive":   "#01DA8C",
    "negative":   "#F3538E",
    "neutral":    "#94A3B8",
    "gridLine":   "#E2E2E8",
    "axisLabel":  "#71717A"
  },

  "typography": {
    "fontFamily": {
      "display": "'Degular Display', 'Degular', 'Space Grotesk', 'Poppins', ui-sans-serif, system-ui, sans-serif",
      "display2": "'Degular', 'Space Grotesk', 'Poppins', ui-sans-serif, system-ui, sans-serif",
      "body":    "'Poppins', ui-sans-serif, system-ui, sans-serif"
    },
    "fontSize": {
      "h1": "clamp(40px, 5vw, 64px)",
      "h2": "32px",
      "h3": "24px",
      "h4": "18px",
      "body": "16px",
      "small": "14px",
      "caption": "12px",
      "eyebrow": "13px"
    },
    "lineHeight": {
      "tight": 1.0, "snug": 1.2, "cozy": 1.3, "normal": 1.4, "relaxed": 1.6
    },
    "letterSpacing": {
      "h1": "-0.02em", "h2": "-0.01em", "eyebrow": "0.08em"
    },
    "fontWeight": {
      "light": 300, "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800, "black": 900
    }
  },

  "radius": {
    "xs": "4px", "sm": "8px", "md": "12px", "lg": "16px", "xl": "20px", "2xl": "24px", "pill": "9999px"
  },

  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px"
  },

  "shadow": {
    "hard":   "4px 4px 0 #14142A",
    "hardSm": "3px 3px 0 #14142A",
    "soft":   "0 4px 20px rgba(0,0,0,0.08)",
    "pop":    "0 8px 28px rgba(20,20,42,0.12)",
    "glow":   "0 0 24px rgba(139,85,254,0.20)"
  },

  "gradient": {
    "brand":     "linear-gradient(135deg, #5029A3 0%, #8B55FE 60%, #C3B1FF 100%)",
    "brandSoft": "linear-gradient(135deg, #8B55FE 0%, #C3B1FF 60%, #ECE8FF 100%)",
    "ia":        "linear-gradient(135deg, #A685FF 0%, #DDD4FF 100%)",
    "teal":      "linear-gradient(135deg, #04949D 0%, #21DDE0 70%, #92FDF7 100%)",
    "warm":      "linear-gradient(135deg, #F9912A 0%, #FBBE81 60%, #FDE0C3 100%)",
    "pink":      "linear-gradient(135deg, #F3538E 0%, #F9A6C4 60%, #FFD3E3 100%)"
  }
}
